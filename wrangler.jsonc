{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-ladissident",
  "main": "./worker/index.ts",
  "workers_dev": false,
  "compatibility_date": "2026-11-09",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "la-dissident-db",
      "database_id": "3cacbb05-190f-4720-a823-15a8482b5541"
    }
  ],
  "observability": {
    "enabled": true
  },
  "ratelimits": [
    {
      "name": "FINANCING_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
