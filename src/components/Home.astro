---
import Base from '../layouts/Base.astro';
import { campaign, content, vimeoVideos } from '../data/content';
const { lang = 'ca' } = Astro.props;
const locale = lang === 'es' ? 'es' : 'ca';
const t = content[locale];
const money = (n:number) => new Intl.NumberFormat(locale === 'ca' ? 'ca-ES' : 'es-ES', { style:'currency', currency:'EUR', maximumFractionDigits:0 }).format(n);
const percent = Math.round(campaign.demoRaised / campaign.goal * 100);
const vimeoId = vimeoVideos[locale];
---
<Base lang={locale} title={`La Dissident · ${t.headline}`} description={t.headline}>
  <header class="site-header">
    <div class="container nav-bar">
      <!-- SUBSTITUEIX public/logo-la-dissident.png per l'arxiu oficial, sense canviar el nom. -->
      <a class="brand" href={`/${locale}/`} aria-label="La Dissident">
        <img src="/logo-la-dissident.png" width="165" height="64" alt="La Dissident" />
      </a>
      <nav class="desktop-nav" aria-label={locale === 'ca' ? 'Menú principal' : 'Menú principal'}>
        <a href="#projecte">{t.navAbout}</a>
        <a href="#preguntes">{t.navFaq}</a>
      </nav>
      <div class="nav-actions">
        <details class="mobile-menu">
          <summary aria-label={locale === 'ca' ? 'Obrir el menú' : 'Abrir el menú'} aria-controls="mobile-navigation"><span class="hamburger" aria-hidden="true"><span></span><span></span><span></span></span></summary>
          <nav id="mobile-navigation" aria-label={locale === 'ca' ? 'Menú mòbil' : 'Menú móvil'}>
            <a href="#projecte">{t.navAbout}</a>
            <a href="#preguntes">{t.navFaq}</a>
          </nav>
        </details>
        <a href="/ca/" lang="ca" aria-current={locale === 'ca' ? 'page' : undefined}>CA</a>
        <span aria-hidden="true">/</span>
        <a href="/es/" lang="es" aria-current={locale === 'es' ? 'page' : undefined}>ES</a>
        <a class="btn btn-small" href="#participa">{t.participate}</a>
      </div>
    </div>
  </header>

  <main>
    <section class="hero" id="campanya">
      <div class="container">
        <h1>{t.headline}</h1>
        <p class="hero-subtitle">{t.subtitle}</p>
        <div class="actions">
          <a class="btn" href="#participa">{t.participate}</a>
          <a class="btn btn-outline" href="#video">{t.watch}</a>
        </div>
        <div class="progress-card">
          <div class="progress-labels"><strong>{money(campaign.demoRaised)} {t.achieved}</strong><strong>{percent}%</strong></div>
          <div class="progress-track" role="progressbar" aria-label={t.achieved} aria-valuemin="0" aria-valuemax={campaign.goal} aria-valuenow={campaign.demoRaised}>
            <div class="progress-fill" style={`width:${Math.min(percent,100)}%`}></div>
          </div>
          <div class="progress-labels minor"><span>{money(Math.max(0,campaign.goal-campaign.demoRaised))} {t.missing}</span><span>{t.updated} {campaign.demoUpdated.split('-').reverse().join('/')}</span></div>
        </div>
      </div>
    </section>

    <section class="section" id="projecte">
      <div class="container split" id="video">
        <div><p class="eyebrow">{t.videoHeading}</p><h2>{t.aboutTitle}</h2><p>{t.about}</p></div>
        <div class="video-frame">
          {vimeoId ? <iframe src={`https://player.vimeo.com/video/${encodeURIComponent(vimeoId)}`} title={t.videoHeading} allow="fullscreen; picture-in-picture" allowfullscreen loading="lazy"></iframe> :
            <div class="video-placeholder"><span class="play-icon" aria-hidden="true">▶</span><p>{t.videoPlaceholder}</p></div>}
        </div>
      </div>
    </section>

    <section class="section cream-section" id="objectius">
      <div class="container narrative">
        <p class="eyebrow">{t.objectivesTitle}</p>
        <div class="narrative-body">
          <h2>{t.goalTitle}</h2><p>{t.goalCopy}</p>
          <h2>{t.conceptTitle}</h2><p>{t.concept}</p>
          <h2>{t.communityTitle}</h2><p>{t.community}</p>
        </div>
      </div>
    </section>

    <section class="section" id="participa">
      <div class="container">
        <h2>{t.choicesTitle}</h2>
        <div class="choice-grid">
          <article class="choice"><div class="circle">01</div><h3>{t.donation}</h3><p>{t.donationDesc}</p><a class="text-link" data-open-form="donation" href="#form-aportacio">{t.donationAction} ↗</a></article>
          <article class="choice"><div class="circle">02</div><h3>{t.loan}</h3><p>{t.loanDesc}</p><a class="text-link" data-open-form="loan" href="#form-prestec">{t.loanAction} ↗</a></article>
          <article class="choice"><div class="circle">03</div><h3>{t.diffusion}</h3><p>{t.diffusionDesc}</p><a class="text-link" href="#difusio">{t.share} ↗</a></article>
        </div>
      </div>
    </section>

    <section class="section cream-section" id="formularis">
      <div class="container">
        <div class="section-heading"><h2>{t.formsHeading}</h2><p>{t.formsIntro}</p></div>
        <div class="forms-container">
        <details class="form-accordion" id="form-aportacio" data-form="donation">
          <summary>{t.formTitle}<span class="accordion-chevron" aria-hidden="true"></span></summary>
          <div class="form-inside">
            <form class="demo-form" data-demo-form="donation">
              <div class="two-cols">
                <label>{t.name}<input name="name" required autocomplete="given-name" /></label>
                <label>{t.surname}<input name="surname" required autocomplete="family-name" /></label>
              </div>
              <label>{t.email}<input name="email" type="email" required autocomplete="email" /></label>
              <fieldset><legend>{t.amount}</legend>
                <div class="amount-options">
                  {[5,15,25,50,100].map(n => <label class="amount-option"><input type="radio" name="preset" value={n} checked={n === 25}/><span>{n} €</span></label>)}
                  <label class="amount-option"><input type="radio" name="preset" value="other"/><span>{t.other}</span></label>
                </div>
                <input class="amount-input" name="amount" type="number" min="0.01" step="0.01" value="25" required aria-label={t.amount}/>
              </fieldset>
              <p class="muted cup-hint">{t.cupHint}</p>

		<fieldset
		  class="cup-field inset-panel"
		  aria-labelledby="cup-heading"
		  hidden
		>
		  <div id="cup-heading" class="cup-heading">
		    {t.cupTitle}
		  </div>
                <label class="check"><input name="cup" type="radio" value="yes"/><span>{t.cupYes}</span></label>
                <label class="check"><input name="cup" type="radio" value="no" checked/><span>{t.cupNo}</span></label>
                <div class="delivery-fields" hidden>
                  <fieldset class="delivery-choice"><legend>{t.deliveryTitle}</legend>
                    <label class="check"><input name="delivery" type="radio" value="pickup" checked/><span>{t.pickup}</span></label>
                    <label class="check"><input name="delivery" type="radio" value="shipping"/><span>{t.shipping}</span></label>
                  </fieldset>
                  <div class="shipping-fields" hidden>
                    <label>{t.address}<input name="address" autocomplete="street-address" placeholder={t.addressPlaceholder} data-shipping-required /></label>
                    <div class="two-cols">
                      <label>{t.postalCode}<input name="postalCode" autocomplete="postal-code" data-shipping-required /></label>
                      <label>{t.city}<input name="city" autocomplete="address-level2" data-shipping-required /></label>
                    </div>
                    <label>{t.province}<input name="province" autocomplete="address-level1" data-shipping-required /></label>
                  </div>
                </div>
              </fieldset>
              <div class="consents">
                <label class="check"><input name="privacy" type="checkbox" required/><span>{t.privacy}</span></label>
                <label class="check"><input name="newsletter" type="checkbox"/><span>{t.news}</span></label>
              </div>
              <p class="info-note">{t.donationNext}</p>
              <button class="btn" type="submit">{t.send}</button>
              <p role="status" aria-live="polite" class="form-status" hidden>{t.demoSuccess}</p>
            </form>
          </div>
        </details>

        <details class="form-accordion" id="form-prestec" data-form="loan">
          <summary>{t.loanTitle}<span class="accordion-chevron" aria-hidden="true"></span></summary>
          <div class="form-inside">
            <p class="info-note">{t.loanWarning}</p>
            <form class="demo-form" data-demo-form="loan">
              <div class="two-cols"><label>{t.name}<input name="name" required autocomplete="given-name" /></label><label>{t.surname}<input name="surname" required autocomplete="family-name" /></label></div>
              <label>{t.email}<input name="email" type="email" required autocomplete="email" /></label>
              <label>{t.phone}<input name="phone" type="tel" autocomplete="tel" /></label>
              <label>{t.amount}<input name="amount" type="number" min="3000" step="100" value="3000" required /></label>
              <p class="muted min-loan-note">{t.minLoan}</p>
              <label>{t.modality}<select name="modality"><option value="0">0 %</option><option value="ipc">IPC (màx. 3 %)</option><option value="unknown">{t.undecided}</option></select></label>
              <label>{t.comment}<textarea name="comment" rows="3"></textarea></label>
              <div class="consents"><label class="check"><input name="privacy" type="checkbox" required/><span>{t.privacy}</span></label><label class="check"><input name="newsletter" type="checkbox"/><span>{t.news}</span></label></div>
              <button class="btn" type="submit">{t.send}</button>
              <p role="status" aria-live="polite" class="form-status" hidden>{t.loanSuccess}</p>
            </form>
          </div>
        </details>
        </div>
      </div>
    </section>

    <section class="section" id="preguntes"><div class="container"><h2>{t.faq}</h2><div class="faq-list">{t.faqItems.map(([question,answer]) => <details class="faq-item"><summary>{question}</summary><p>{answer}</p></details>)}</div></div></section>
    <section class="section share-section" id="difusio"><div class="container narrow"><h2>{t.shareTitle}</h2><p>{t.shareCopy}</p><button class="btn share-btn" data-share data-copy={t.copied}>{t.share}</button><p class="share-status" role="status" aria-live="polite"></p></div></section>
  </main>

<footer class="site-footer">
  <div class="container footer-inner">

    <!-- Esquerra: correu -->
    <a href="mailto:hola@ladissident.org" class="footer-email">
      hola@ladissident.org
    </a>

    <!-- Centre: logotip crema -->
    <a href={`/${lang}/`} class="footer-brand">
      <img
        src="/logo-la-dissident-2.png"
        alt="La Dissident"
      />
    </a>

    <!-- Dreta: enllaços legals -->
    <nav class="footer-legal" aria-label="Enllaços legals">
      <a href={`/${lang}/avis-legal/`}>Avís legal</a>
      <span>·</span>
      <a href={`/${lang}/privacitat/`}>Privacitat</a>
      <span>·</span>
      <a href={`/${lang}/cookies/`}>Cookies</a>
    </nav>

  </div>
</footer>

  <script>
    const header = document.querySelector<HTMLElement>('.site-header');
    const updateHeader = () => header?.classList.toggle('is-scrolled', window.scrollY > 10);
    addEventListener('scroll', updateHeader, { passive:true });
    updateHeader();
    const mobileMenu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
    mobileMenu?.querySelectorAll('nav a').forEach(link => link.addEventListener('click', () => { mobileMenu.open = false; }));
    document.addEventListener('click', event => {
      if (mobileMenu?.open && !mobileMenu.contains(event.target as Node)) mobileMenu.open = false;
    });
    const accordions = Array.from(document.querySelectorAll<HTMLDetailsElement>('.form-accordion'));
    accordions.forEach(current => current.addEventListener('toggle', () => {
      if (current.open) accordions.forEach(other => { if (other !== current) other.open = false; });
    }));
    const openAccordion = (kind: string, scroll = true) => {
      const target = accordions.find(el => el.dataset.form === kind);
      if (!target) return;
      accordions.forEach(el => { el.open = el === target; });
      if (scroll) requestAnimationFrame(() => target.scrollIntoView({ behavior:'smooth', block:'start' }));
    };
    document.querySelectorAll<HTMLAnchorElement>('[data-open-form]').forEach(link => link.addEventListener('click', () => {
      openAccordion(link.dataset.openForm || '', false);
    }));
    const openFromHash = () => {
      if (location.hash === '#form-aportacio') openAccordion('donation', false);
      if (location.hash === '#form-prestec') openAccordion('loan', false);
    };
    addEventListener('hashchange', openFromHash);
    openFromHash();

    document.querySelectorAll<HTMLFormElement>('.demo-form').forEach(form => {
      form.addEventListener('submit', event => {
        event.preventDefault(); // NO enviar datos personales en el prototipo.
        const status = form.querySelector<HTMLElement>('.form-status');
        if (status) { status.hidden = false; status.scrollIntoView({ behavior:'smooth', block:'nearest' }); }
      });
    });

    const donation = document.querySelector<HTMLFormElement>('[data-demo-form="donation"]');
    if (donation) {
      const amount = donation.querySelector<HTMLInputElement>('.amount-input')!;
      const hint = donation.querySelector<HTMLElement>('.cup-hint')!;
      const cupField = donation.querySelector<HTMLElement>('.cup-field')!;
      const deliveryFields = donation.querySelector<HTMLElement>('.delivery-fields')!;
      const shippingFields = donation.querySelector<HTMLElement>('.shipping-fields')!;
      const cupYes = donation.querySelector<HTMLInputElement>('[name="cup"][value="yes"]')!;
      const cupNo = donation.querySelector<HTMLInputElement>('[name="cup"][value="no"]')!;
      const pickup = donation.querySelector<HTMLInputElement>('[name="delivery"][value="pickup"]')!;
      const shipping = donation.querySelector<HTMLInputElement>('[name="delivery"][value="shipping"]')!;
      const shippingInputs = donation.querySelectorAll<HTMLInputElement>('[data-shipping-required]');
      const updateCup = () => {
        const eligible = Number(amount.value) >= 50;
        cupField.hidden = !eligible;
        hint.hidden = eligible;
        if (!eligible) { cupNo.checked = true; pickup.checked = true; }
        deliveryFields.hidden = !eligible || !cupYes.checked;
        shippingFields.hidden = deliveryFields.hidden || !shipping.checked;
        shippingInputs.forEach(input => { input.required = !shippingFields.hidden; input.disabled = shippingFields.hidden; });
      };
      donation.querySelectorAll<HTMLInputElement>('[name="preset"]').forEach(radio => radio.addEventListener('change', () => {
        if (!radio.checked) return;
        if (radio.value === 'other') { amount.value = ''; amount.focus(); }
        else amount.value = radio.value;
        updateCup();
      }));
      amount.addEventListener('input', () => {
        const selected = donation.querySelector<HTMLInputElement>('[name="preset"]:checked');
        if (selected && selected.value !== amount.value) {
          const other = donation.querySelector<HTMLInputElement>('[name="preset"][value="other"]');
          if (other) other.checked = true;
        }
        updateCup();
      });
      donation.querySelectorAll<HTMLInputElement>('[name="cup"], [name="delivery"]').forEach(r => r.addEventListener('change', updateCup));
      updateCup();
    }


const share = document.querySelector<HTMLButtonElement>('[data-share]');
const shareStatus = document.querySelector<HTMLElement>('.share-status');

share?.addEventListener('click', async () => {
  const url = window.location.href.split('#')[0];
  const title = document.title;

  if (shareStatus) shareStatus.textContent = '';

  // Primer intentem obrir sempre el menú natiu del mòbil.
  if (typeof navigator.share === 'function') {
    try {
      await navigator.share({
        title,
        text: title,
        url
      });

      return;
    } catch (error) {
      // Si la persona cancel·la, no fem res.
      if ((error as Error).name === 'AbortError') {
        return;
      }

      // Altres errors: mostrem una alternativa manual.
      console.warn('No s’ha pogut compartir:', error);
    }
  }

  // Alternativa: copiar l'enllaç.
  try {
    await navigator.clipboard.writeText(url);

    if (shareStatus) {
  shareStatus.textContent =
  window.location.pathname.startsWith('/es/')
    ? 'Enlace copiado. ¡Gracias!'
    : 'Enllaç copiat. Gràcies!';
    }
  } catch {
    // Últim recurs quan el navegador no permet copiar.
    if (shareStatus) {
      shareStatus.textContent = url;
    }
  }
});

  </script>
</Base>
